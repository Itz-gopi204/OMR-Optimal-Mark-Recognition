# Application Settings
APP_NAME=OMR Evaluation System
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=omr_evaluation

# Redis
REDIS_URL=redis://localhost:6379

# JWT Authentication
SECRET_KEY=your-super-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# File Storage
STORAGE_TYPE=local
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760

# S3/MinIO (Optional - for production)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=omr-sheets
S3_REGION=us-east-1

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Email (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@omr-system.com

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# OMR Processing
OMR_CONFIDENCE_THRESHOLD=0.7
OMR_FILL_THRESHOLD=0.4
